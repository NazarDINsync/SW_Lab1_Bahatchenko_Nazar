ex:artist_lfo a schema1:MusicGroup ;
    rdfs:label "LFO"@uk ;
    ex:hasGenre ex:genre_breakbeat ;
    schema1:name "LFO" .

ex:artist_orbital a schema1:MusicGroup ;
    rdfs:label "Orbital"@uk ;
    ex:hasGenre ex:genre_techno ;
