ex:label_warp a ex:RecordLabel ;
    rdfs:label "Warp Records"@uk ;
    schema1:name "Warp Records" .

ex:artist_aphextwin a schema1:MusicGroup ;
    rdfs:label "Aphex Twin"@uk ;
