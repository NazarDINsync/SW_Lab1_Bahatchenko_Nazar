@prefix dbr: <http://dbpedia.org/resource/> .
@prefix ex: <http://example.org/music/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:album_exel8 a schema1:MusicAlbum ;
    rdfs:label "ex.el8"@uk ;
    ex:hasTrack ex:song_cubik,
        ex:song_pacman ;
    ex:releasedBy ex:artist_808state ;
    schema1:datePublished "1991"^^xsd:gYear ;
    schema1:name "ex.el8" .

ex:album_frequencies a schema1:MusicAlbum ;
    rdfs:label "Frequencies"@uk ;
    ex:hasTrack ex:song_lfo_track,
        ex:song_mentaldread ;
    ex:recordLabel ex:label_warp ;
    ex:releasedBy ex:artist_lfo ;
    schema1:datePublished "1991"^^xsd:gYear ;
    schema1:name "Frequencies" .

ex:album_orbital1 a schema1:MusicAlbum ;
    rdfs:label "Orbital (Green Album)"@uk ;
    ex:hasTrack ex:song_chime,
        ex:song_midnight ;
    ex:recordLabel ex:label_rs ;
    ex:releasedBy ex:artist_orbital ;
    schema1:datePublished "1991"^^xsd:gYear ;
    schema1:name "Orbital (Green Album)" .

ex:album_rdjalbum a schema1:MusicAlbum ;
    rdfs:label "Richard D. James Album"@uk ;
    ex:hasTrack ex:song_fourtrack,
        ex:song_girlboy ;
    ex:recordLabel ex:label_warp ;
    ex:releasedBy ex:artist_aphextwin ;
    schema1:datePublished "1996"^^xsd:gYear ;
    schema1:name "Richard D. James Album" .

ex:album_selectedambient a schema1:MusicAlbum ;
    rdfs:label "Selected Ambient Works 85-92"@uk ;
    ex:hasTrack ex:song_tha,
        ex:song_xtalcal ;
    ex:recordLabel ex:label_warp ;
    ex:releasedBy ex:artist_aphextwin ;
    schema1:datePublished "1992"^^xsd:gYear ;
    schema1:name "Selected Ambient Works 85-92" .

ex:label_mute a ex:RecordLabel ;
    rdfs:label "Mute Records"@uk ;
    schema1:name "Mute Records" .

ex:song_koma a schema1:MusicRecording ;
    rdfs:label "Koma"@uk ;
    ex:duration 420 ;
    ex:performedBy ex:artist_plastikman ;
    schema1:name "Koma" .

ex:song_spastik a schema1:MusicRecording ;
    rdfs:label "Spastik"@uk ;
    ex:duration 391 ;
    ex:performedBy ex:artist_plastikman ;
    schema1:name "Spastik" .

ex:genre_acidhouse a ex:Genre ;
    rdfs:label "Acid House"@uk ;
    schema1:name "Acid House" .

ex:genre_ambient a ex:Genre ;
    rdfs:label "Ambient"@uk ;
    schema1:name "Ambient" .

ex:genre_breakbeat a ex:Genre ;
    rdfs:label "Breakbeat"@uk ;
    schema1:name "Breakbeat" .

ex:label_rs a ex:RecordLabel ;
    rdfs:label "R&S Records"@uk ;
    schema1:name "R&S Records" .

ex:song_chime a schema1:MusicRecording ;
    rdfs:label "Chime"@uk ;
    ex:duration 410 ;
    ex:performedBy ex:artist_orbital ;
    schema1:name "Chime" .

ex:song_cubik a schema1:MusicRecording ;
    rdfs:label "Cubik"@uk ;
    ex:duration 300 ;
    ex:performedBy ex:artist_808state ;
    schema1:name "Cubik" .

ex:song_fourtrack a schema1:MusicRecording ;
    rdfs:label "4"@uk ;
    ex:duration 217 ;
    ex:performedBy ex:artist_aphextwin ;
    schema1:name "4" .

ex:song_girlboy a schema1:MusicRecording ;
    rdfs:label "Girl/Boy Song"@uk ;
    ex:duration 244 ;
    ex:performedBy ex:artist_aphextwin ;
