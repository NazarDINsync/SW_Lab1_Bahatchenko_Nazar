ex:song_mentaldread a schema1:MusicRecording ;
    rdfs:label "Mental Dread"@uk ;
    ex:duration 248 ;
    ex:performedBy ex:artist_lfo ;
    schema1:name "Mental Dread" .

ex:song_midnight a schema1:MusicRecording ;
    rdfs:label "Midnight"@uk ;
    ex:duration 362 ;
    ex:performedBy ex:artist_orbital ;
    schema1:name "Midnight" .

ex:song_pacman a schema1:MusicRecording ;
    rdfs:label "Pacman"@uk ;
    ex:duration 265 ;
    ex:performedBy ex:artist_808state ;
    schema1:name "Pacman" .

ex:song_tha a schema1:MusicRecording ;
    rdfs:label "Tha"@uk ;
